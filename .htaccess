<IfModule mod_rewrite.c>
  RewriteEngine On

  # Producción: todo por https y sin www. No toca /.well-known (validación del
  # certificado AutoSSL por http) ni otros dominios (localhost, tuweb.cl).
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTP_HOST} ^(www\.)?travelonline\.cl$ [NC]
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://travelonline.cl%{REQUEST_URI} [R=301,L]

  # Redirecciones 301 del WordPress anterior (permalinks simples: ?page_id=N, ?product=slug).
  # Solo aplican en la raíz; el destino termina en ? para descartar la query vieja.
  RewriteCond %{QUERY_STRING} ^page_id=239$
  RewriteRule ^(index\.php)?$ /destinos/europa? [R=301,L]
  RewriteCond %{QUERY_STRING} ^page_id=343$
  RewriteRule ^(index\.php)?$ /contacto? [R=301,L]
  RewriteCond %{QUERY_STRING} ^page_id=373$
  RewriteRule ^(index\.php)?$ /paquetes/circuito-madrid-paris? [R=301,L]
